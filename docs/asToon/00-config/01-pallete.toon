    properties[70]: "--slate-0","--slate-25","--slate-50","--slate-100","--slate-200","--slate-300","--slate-400","--slate-500","--slate-600","--slate-700","--slate-800","--slate-850","--slate-900","--slate-925","--slate-950","--gray-50","--gray-100","--gray-200","--gray-300","--gray-400","--gray-500","--gray-600","--gray-700","--gray-800","--gray-900","--gray-950","--blue-50","--blue-100","--blue-200","--blue-300","--blue-400","--blue-500","--blue-600","--blue-700","--blue-800","--blue-900","--blue-950","--green-50","--green-100","--green-200","--green-300","--green-400","--green-500","--green-600","--green-700","--green-800","--green-900","--green-950","--yellow-50","--yellow-100","--yellow-200","--yellow-300","--yellow-400","--yellow-500","--yellow-600","--yellow-700","--yellow-800","--yellow-900","--yellow-950","--red-50","--red-100","--red-200","--red-300","--red-400","--red-500","--red-600","--red-700","--red-800","--red-900","--red-950"
    cssRule: "/* == Neutral Palette (Slate, cool bias toward the brand blue) == */\n--slate-0: #fff\n--slate-25: #fbfcfd\n--slate-50: #f6f7f9\n--slate-100: #eef0f4\n--slate-200: #e1e5eb\n--slate-300: #c3c9d4\n--slate-400: #8b95a8\n--slate-500: #6b7486\n--slate-600: #5a6478\n--slate-700: #3a4252\n--slate-800: #232936\n--slate-850: #1b202b\n--slate-900: #161a23\n--slate-925: #10131a\n--slate-950: #090b10\n/* == Gray (v2 name, now slate) == */\n--gray-50: var(--slate-50)\n--gray-100: var(--slate-100)\n--gray-200: var(--slate-200)\n--gray-300: var(--slate-300)\n--gray-400: var(--slate-400)\n--gray-500: var(--slate-500)\n--gray-600: var(--slate-600)\n--gray-700: var(--slate-700)\n--gray-800: var(--slate-800)\n--gray-900: var(--slate-900)\n--gray-950: var(--slate-950)\n/* == Primary Palette (Blue, 500 = brand) == */\n--blue-50: #eef5ff\n--blue-100: #d9e8ff\n--blue-200: #bcd6ff\n--blue-300: #8ebbff\n--blue-400: #5c9bff\n--blue-500: #2476ff\n--blue-600: #1660e6\n--blue-700: #124dbb\n--blue-800: #153f94\n--blue-900: #173775\n--blue-950: #111f45\n/* == Accent Palette: Green (Success) == */\n--green-50: hsl(140deg 65% 96%)\n--green-100: hsl(140deg 65% 90%)\n--green-200: hsl(140deg 60% 80%)\n--green-300: hsl(140deg 60% 70%)\n--green-400: hsl(140deg 60% 60%)\n--green-500: hsl(140deg 60% 45%)\n--green-600: hsl(140deg 70% 35%)\n--green-700: hsl(140deg 75% 28%)\n--green-800: hsl(140deg 75% 20%)\n--green-900: hsl(140deg 80% 15%)\n--green-950: hsl(140deg 85% 10%)\n/* == Accent Palette: Yellow (Warning) == */\n--yellow-50: hsl(45deg 95% 96%)\n--yellow-100: hsl(45deg 95% 90%)\n--yellow-200: hsl(45deg 90% 80%)\n--yellow-300: hsl(45deg 90% 70%)\n--yellow-400: hsl(45deg 90% 60%)\n--yellow-500: hsl(45deg 90% 50%)\n--yellow-600: hsl(42deg 85% 45%)\n--yellow-700: hsl(40deg 80% 38%)\n--yellow-800: hsl(38deg 75% 30%)\n--yellow-900: hsl(36deg 70% 22%)\n--yellow-950: hsl(35deg 65% 15%)\n/* == Accent Palette: Red (Danger) == */\n--red-50: hsl(0deg 85% 96%)\n--red-100: hsl(0deg 85% 90%)\n--red-200: hsl(0deg 80% 80%)\n--red-300: hsl(0deg 80% 70%)\n--red-400: hsl(0deg 80% 60%)\n--red-500: hsl(0deg 75% 50%)\n--red-600: hsl(0deg 70% 42%)\n--red-700: hsl(0deg 75% 35%)\n--red-800: hsl(0deg 75% 28%)\n--red-900: hsl(0deg 80% 20%)\n--red-950: hsl(0deg 85% 15%)"
    responsive: false
    description: "|--------------------------------------------------------------------------\n| Raw Color Palette @ID: #00-01-01\n|--------------------------------------------------------------------------\n|\n| This file contains the raw color options for the design system.\n| These variables represent the \"what we have\" and should rarely\n| be used directly in components.\n|\n| v3: blue ramp built around the brand blue #2476ff (500) and a cool slate\n| neutral ramp. --gray-* are kept as aliases of --slate-* for compatibility.\n|"
