  - type: selector
    selectorType: pseudo
    selector: ":root"
    id: #00-01-01
    category: null
    properties[55]: "--gray-50","--gray-100","--gray-200","--gray-300","--gray-400","--gray-500","--gray-600","--gray-700","--gray-800","--gray-900","--gray-950","--blue-50","--blue-100","--blue-200","--blue-300","--blue-400","--blue-500","--blue-600","--blue-700","--blue-800","--blue-900","--blue-950","--green-50","--green-100","--green-200","--green-300","--green-400","--green-500","--green-600","--green-700","--green-800","--green-900","--green-950","--yellow-50","--yellow-100","--yellow-200","--yellow-300","--yellow-400","--yellow-500","--yellow-600","--yellow-700","--yellow-800","--yellow-900","--yellow-950","--red-50","--red-100","--red-200","--red-300","--red-400","--red-500","--red-600","--red-700","--red-800","--red-900","--red-950"
    cssRule: "/*== Neutral Palette (Gray) ==*/\n--gray-50: hsl(210, 20%, 95%)\n--gray-100: hsl(210, 18%, 89%)\n--gray-200: hsl(210, 15%, 82%)\n--gray-300: hsl(210, 13%, 70%)\n--gray-400: hsl(210, 11%, 60%)\n--gray-500: hsl(210, 9%, 50%)\n--gray-600: hsl(210, 10%, 40%)\n--gray-700: hsl(210, 12%, 30%)\n--gray-800: hsl(210, 15%, 20%)\n--gray-900: hsl(210, 20%, 10%)\n--gray-950: hsl(210, 25%, 5%)\n/*== Primary Palette (Blue) ==*/\n--blue-50: hsl(210, 90%, 96%)\n--blue-100: hsl(210, 90%, 90%)\n--blue-200: hsl(210, 90%, 80%)\n--blue-300: hsl(210, 90%, 70%)\n--blue-400: hsl(210, 90%, 60%)\n--blue-500: hsl(210, 90%, 50%)\n--blue-600: hsl(210, 85%, 40%)\n--blue-700: hsl(210, 80%, 30%)\n--blue-800: hsl(210, 80%, 25%)\n--blue-900: hsl(210, 85%, 20%)\n--blue-950: hsl(210, 90%, 15%)\n/*== Accent Palette: Green (Success) ==*/\n--green-50: hsl(140, 65%, 96%)\n--green-100: hsl(140, 65%, 90%)\n--green-200: hsl(140, 60%, 80%)\n--green-300: hsl(140, 60%, 70%)\n--green-400: hsl(140, 60%, 60%)\n--green-500: hsl(140, 60%, 45%)\n--green-600: hsl(140, 70%, 35%)\n--green-700: hsl(140, 75%, 28%)\n--green-800: hsl(140, 75%, 20%)\n--green-900: hsl(140, 80%, 15%)\n--green-950: hsl(140, 85%, 10%)\n/*== Accent Palette: Yellow (Warning) ==*/\n--yellow-50: hsl(45, 95%, 96%)\n--yellow-100: hsl(45, 95%, 90%)\n--yellow-200: hsl(45, 90%, 80%)\n--yellow-300: hsl(45, 90%, 70%)\n--yellow-400: hsl(45, 90%, 60%)\n--yellow-500: hsl(45, 90%, 50%)\n--yellow-600: hsl(42, 85%, 45%)\n--yellow-700: hsl(40, 80%, 38%)\n--yellow-800: hsl(38, 75%, 30%)\n--yellow-900: hsl(36, 70%, 22%)\n--yellow-950: hsl(35, 65%, 15%)\n/*== Accent Palette: Red (Danger) ==*/\n--red-50: hsl(0, 85%, 96%)\n--red-100: hsl(0, 85%, 90%)\n--red-200: hsl(0, 80%, 80%)\n--red-300: hsl(0, 80%, 70%)\n--red-400: hsl(0, 80%, 60%)\n--red-500: hsl(0, 75%, 50%)\n--red-600: hsl(0, 70%, 42%)\n--red-700: hsl(0, 75%, 35%)\n--red-800: hsl(0, 75%, 28%)\n--red-900: hsl(0, 80%, 20%)\n--red-950: hsl(0, 85%, 15%)"
    responsive: false
    description: "|--------------------------------------------------------------------------\r\n| Raw Color Palette @ID: #00-01-01\r\n|--------------------------------------------------------------------------\r\n|\r\n| This file contains the raw color options for the design system.\r\n| These variables represent the \"what we have\" and should rarely\r\n| be used directly in components.\r\n|"
