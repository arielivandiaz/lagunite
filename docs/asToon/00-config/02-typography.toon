    cssRule: "--font-sans: \"Instrument Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif\n--font-display: \"Bricolage Grotesque\", \"Instrument Sans\", system-ui, sans-serif\n--font-mono: \"JetBrains Mono\", ui-monospace, \"SF Mono\", monospace\n--font-text: var(--font-sans)\n--font-headers: var(--font-display)\n--font-size-xs: 0.75rem\n/* 12px */\n--font-size-s: 0.875rem\n/* 14px */\n--font-size-base: 1rem\n/* 16px */\n--font-size-l: 1.125rem\n/* 18px */\n--font-size-xl: 1.25rem\n/* 20px */\n--font-size-xxl: 1.5rem\n/* 24px */\n--font-size-3xl: 2rem\n/* 32px */\n--font-size-display-l: 2.75rem\n/* 44px */\n--font-size-display-xl: 3.5rem\n/* 56px */\n--font-size-display-2xl: 4.5rem\n/* 72px */\n--font-weight-light: 300\n--font-weight-normal: 400\n--font-weight-medium: 500\n--font-weight-semibold: 600\n--font-weight-bold: 700\n--line-height-tight: 1.15\n--line-height-normal: 1.5\n--line-height-loose: 1.8\n--letter-spacing-display: -0.03em\n--letter-spacing-title: -0.015em"
