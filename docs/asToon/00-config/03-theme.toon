  "--shadow-inner",inset 0 1px 2px rgb(0 0 0 / 50%)
  "--shadow-primary","0 1px 2px rgb(0 0 0 / 50%), 0 8px 22px -6px rgb(36 118 255 / 55%)"
  "--shadow-primary-hover","0 2px 4px rgb(0 0 0 / 50%), 0 14px 32px -8px rgb(36 118 255 / 65%)"
  "--shadow-focus",0 0 0 3px rgb(92 155 255 / 55%)
  "--gradient-text","linear-gradient(100deg, var(--blue-200) 0%, var(--blue-400) 45%, var(--color-primary) 100%)"
  "--gradient-border","linear-gradient(140deg, var(--blue-400) 0%, var(--color-primary) 40%, var(--blue-800) 70%, var(--blue-400) 100%)"
  "--color-text",var(--color-text-base)
  "--color-on-fill",var(--color-text-alt)
  "--color-danger",var(--color-error)
  "--color-danger-soft",var(--color-error-light)
  "--color-surface-sunken",var(--color-surface-muted)
  "--color-border-hover",var(--color-border-strong)
  "--input-text",var(--color-text-base)
  "--input-bg",var(--color-surface-raised)
  "--input-placeholder",var(--color-text-subtle)
  "--bg-primary","linear-gradient(180deg, var(--color-primary-fill) 0%, var(--color-primary-fill-end) 100%)"
  "--bg-secondary","linear-gradient(180deg, var(--slate-600) 0%, var(--slate-800) 100%)"
  "--bg-tertiary","linear-gradient(180deg, var(--color-surface-raised) 0%, var(--color-surface-muted) 100%)"
  "--gradient-primary","linear-gradient(180deg, rgb(255 255 255 / 18%) 0%, rgb(255 255 255 / 0%) 52%), linear-gradient(180deg, var(--color-primary-fill) 0%, var(--color-primary-fill-end) 100%)"
  "--border",1px solid var(--color-border-strong)
  "--border-light",1px solid var(--color-border)
  "--border-dark",1px solid var(--color-primary)