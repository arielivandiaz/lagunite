folder: 08-organisms
file: 01-navbar.css
lastUpdated: 2026-11-12
hasResponsive: false
totalSelectors: 32
content[32]:
  - type: selector
    selectorType: class
    selector: .navbar
    id: #08-01-01
    category: null
    properties[12]: display,align-items,justify-content,gap,min-height,padding,background,"-webkit-backdrop-filter",backdrop-filter,border-bottom,position,z-index
    cssRule: "display: flex\nalign-items: center\njustify-content: space-between\ngap: var(--space-6)\nmin-height: 4rem\npadding: var(--space-3) var(--space-6)\nbackground: var(--color-glass)\n-webkit-backdrop-filter: blur(var(--blur-md)) saturate(160%)\nbackdrop-filter: blur(var(--blur-md)) saturate(160%)\nborder-bottom: var(--border-width-s) solid var(--color-border)\nposition: relative\nz-index: 100"
    responsive: false
    description: ── Navbar shell ─────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .navbar-floating
    id: #08-01-01
    category: null
    properties[8]: top,max-width,min-height,margin,padding,border,border-radius,box-shadow
    cssRule: "top: var(--space-3)\nmax-width: 1080px\nmin-height: 3.5rem\nmargin: var(--space-3) auto 0\npadding: var(--space-2) var(--space-2) var(--space-2) var(--space-5)\nborder: 0\nborder-radius: var(--radius-full)\nbox-shadow: inset 0 1px 0 var(--color-highlight), 0 0 0 1px var(--color-border-strong), var(--shadow-l)"
    responsive: false
    description: ── Navbar shell ─────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .navbar-brand
    id: #08-01-02
    category: null
    properties[9]: display,align-items,gap,font-family,font-size,font-weight,letter-spacing,color,text-decoration
    cssRule: "display: flex\nalign-items: center\ngap: 0.625rem\nfont-family: var(--font-display)\nfont-size: var(--font-size-l)\nfont-weight: var(--font-weight-bold)\nletter-spacing: -0.02em\ncolor: var(--color-text-base)\ntext-decoration: none"
    responsive: false
    description: ── Brand & nav list ─────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .navbar-brand img
    id: #08-01-02
    category: null
    properties[1]: height
    cssRule: "height: 2rem"
    responsive: false
    description: ── Brand & nav list ─────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .brand-mark
    id: #08-01-02
    category: null
    properties[6]: flex,width,height,border-radius,background,box-shadow
    cssRule: "flex: none\nwidth: 1.625rem\nheight: 1.625rem\nborder-radius: var(--radius-sm)\nbackground: var(--gradient-primary)\nbox-shadow: inset 0 1px 0 rgb(255 255 255 / 30%), var(--shadow-primary)"
    responsive: false
    description: "Placeholder mark when there is no logo: a square with the primary gradient"
  - type: selector
    selectorType: class
    selector: .navbar-nav
    id: #08-01-02
    category: null
    properties[6]: display,align-items,gap,list-style,margin,padding
    cssRule: "display: flex\nalign-items: center\ngap: var(--space-1)\nlist-style: none\nmargin: 0\npadding: 0"
    responsive: false
    description: "Placeholder mark when there is no logo: a square with the primary gradient"
  - type: selector
    selectorType: class
    selector: .navbar-link
    id: #08-01-03
    category: null
    properties[10]: display,align-items,min-height,padding,color,text-decoration,font-size,font-weight,border-radius,transition
    cssRule: "display: inline-flex\nalign-items: center\nmin-height: 2.25rem\npadding: 0 var(--space-3)\ncolor: var(--color-text-muted)\ntext-decoration: none\nfont-size: var(--font-size-s)\nfont-weight: var(--font-weight-medium)\nborder-radius: var(--radius-full)\ntransition:\n    background var(--dur) var(--ease-out),\n    color var(--dur) var(--ease-out)"
    responsive: false
    description: ── Nav links ────────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: ".navbar-link:hover"
    id: #08-01-03
    category: null
    properties[2]: background,color
    cssRule: "background: var(--color-surface-muted)\ncolor: var(--color-text-base)"
    responsive: false
    description: ── Nav links ────────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .navbar-link.active
    id: #08-01-03
    category: null
    properties[2]: background,color
    cssRule: "background: var(--color-surface-muted)\ncolor: var(--color-text-base)"
    responsive: false
    description: ── Nav links ────────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: ".navbar-link:focus-visible"
    id: #08-01-03
    category: null
    properties[3]: outline,box-shadow,border-radius
    cssRule: "outline: none\nbox-shadow: var(--shadow-focus)\nborder-radius: var(--radius-full)"
    responsive: false
    description: ── Nav links ────────────────────────────────────────────────────────────
