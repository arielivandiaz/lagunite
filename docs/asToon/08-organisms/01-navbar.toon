  - type: selector
    selectorType: class
    selector: .navbar-burger span
    id: #08-01-04
    category: null
    properties[8]: display,flex-shrink,width,height,margin,border-radius,background,transition
    cssRule: "display: block\nflex-shrink: 0\nwidth: 1.25rem\nheight: 2px\nmargin: 2px 0\nborder-radius: 2px\nbackground: var(--color-text-base)\ntransition: transform var(--dur) var(--ease-out), opacity var(--dur) var(--ease-out)"
    responsive: false
    description: ── Mobile burger ─────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: ".navbar.open .navbar-burger span:nth-child(1)"
    id: #08-01-04
    category: null
    properties[1]: transform
    cssRule: "transform: translateY(6px) rotate(45deg)"
    responsive: false
    description: ── Mobile burger ─────────────────────────────────────────────────────────
