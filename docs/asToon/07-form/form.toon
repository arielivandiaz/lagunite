    id: null
    category: null
    properties[6]: position,overflow,background,border-radius,margin,box-shadow
    cssRule: ".select {\r\n    position: relative;\r\n    overflow: hidden;\r\n    background: rgba(var(--primary_color_rgb), 0.2);\r\n    border-radius: var(--radius);\r\n    margin: 10px 20px;\r\n    box-shadow: 0 0 15px 2px rgba(255, 255, 255, 0.12);\r\n}"
