    id: null
    category: null
    properties[9]: left,top,width,height,border,border-width,"-webkit-transform","-ms-transform",transform
    cssRule: ".checkbox .checkmark:after {\r\n    left: 8px;\r\n    top: -10px;\r\n    width: 10px;\r\n    height: 28px;\r\n    border: solid white;\r\n    border-width: 0 5px 5px 0;\r\n    -webkit-transform: rotate(45deg);\r\n    -ms-transform: rotate(45deg);\r\n    transform: rotate(45deg);\r\n}"
    responsive: false
    description: ""
