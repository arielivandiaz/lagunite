    cssRule: ".checkbox input:checked ~ .checkmark {\r\n    background-color: var(--primary_color);\r\n    box-shadow: 0 0 8px 1px var(--primary_color);\r\n    border-radius: 6px;\r\n}"
    responsive: false
    description: ""
  - type: selector
