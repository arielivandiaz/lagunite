    responsive: false
    description: ""
  - type: selector
    selectorType: class
    selector: .checkmark
    id: null
    category: null
    properties[8]: position,top,height,width,margin-left,border-radius,border,cursor
    cssRule: ".checkmark {\r\n    position: absolute;\r\n    top: 0;\r\n    height: 25px;\r\n    width: 25px;\r\n    margin-left: 25px;\r\n    border-radius: 8px;\r\n    border: 3px solid var(--primary_color);\r\n    cursor: pointer;\r\n}"
    responsive: false
    description: ""
