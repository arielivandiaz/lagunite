    properties[18]: appearance,outline,box-shadow,min-width,height,margin,padding,color,font-weight,cursor,background,color,border,border-radius,cursor,line-height,min-width,margin-right
    cssRule: "select {\r\n    appearance: none;\r\n    outline: 0;\r\n    box-shadow: none;\r\n    min-width: 220px;\r\n    height: 100%;\r\n    margin: 0;\r\n    padding: 6px 12px;\r\n    color: var(--text_color);\r\n    font-weight: 700;\r\n    cursor: pointer;\r\n    background: none;\r\n    color: var(--text_color);\r\n    border: var(--border);\r\n    border-radius: var(--radius);\r\n    cursor: pointer;\r\n    line-height: 1;\r\n    min-width: 100px;\r\n    margin-right: 15px;\r\n}"
