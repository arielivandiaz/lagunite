    cssRule: ".checkbox:hover input ~ .checkmark {\r\n    box-shadow: 0 0 8px 1px var(--primary_color);\r\n}"
    responsive: false
    description: ""
  - type: selector
    selectorType: class
    selector: ".checkbox input:checked ~ .checkmark"
    id: null
