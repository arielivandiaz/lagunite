    cssRule: ".checkboxContainer {\r\n    position: relative;\r\n    display: block;\r\n    cursor: pointer;\r\n    -webkit-user-select: none;\r\n    -moz-user-select: none;\r\n    -ms-user-select: none;\r\n    user-select: none;\r\n    margin: 8px 30px 10px 10px;\r\n    padding: 5px 25px;\r\n}"
