    properties[10]: content,position,top,right,bottom,padding,background,color,pointer-events,background
    cssRule: ".select::after {\r\n    content: '\\25BC';\r\n    position: absolute;\r\n    top: 0;\r\n    right: 0;\r\n    bottom: 0;\r\n    padding: 3px 5px;\r\n    background: none;\r\n    color: var(--text_color_alt);\r\n    pointer-events: none;\r\n    background: var(--primary_color);\r\n}"
    responsive: false
