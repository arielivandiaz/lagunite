    cssRule: "display: inline-flex\nalign-items: center\ngap: var(--space-1)\nmin-height: 1.5rem\npadding: 0.15rem var(--space-2)\nborder-radius: var(--radius-s)\nborder: var(--border-width-s) solid var(--gray-300)\nbackground: var(--gray-100)\ncolor: var(--gray-800)\nfont-size: var(--font-size-xs)\nfont-weight: var(--font-weight-medium)\nline-height: 1.2\nwhite-space: nowrap\ntext-decoration: none\nuser-select: none"
