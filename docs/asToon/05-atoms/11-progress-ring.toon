    properties[17]: "--progress-ring-size","--progress-ring-thickness","--progress-ring-track","--progress-ring-fill","--progress-ring-value",appearance,display,width,height,border-radius,border,background,background-origin,background-clip,mask-image,vertical-align,transition
    cssRule: "--progress-ring-size: 6rem\n--progress-ring-thickness: 0.75rem\n--progress-ring-track: var(--gray-200)\n--progress-ring-fill: var(--color-primary)\n--progress-ring-value: 0\nappearance: none\ndisplay: block\nwidth: var(--progress-ring-size)\nheight: var(--progress-ring-size)\nborder-radius: 50%\nborder: var(--progress-ring-thickness) solid transparent\nbackground:\r\n    conic-gradient(\r\n      var(--progress-ring-fill) calc(var(--progress-ring-value) * 1%),\r\n      var(--progress-ring-track) 0\r\n    )\nbackground-origin: border-box\nbackground-clip: border-box\n/* Hollow center — mask works wider than background-clip: border-area */\nmask-image: radial-gradient(\r\n    farthest-side,\r\n    transparent calc(100% - var(--progress-ring-thickness) - 0.5px),\r\n    #000 calc(100% - var(--progress-ring-thickness))\r\n  )\nvertical-align: middle\ntransition: --progress-ring-value 0s ease-in-out"
    responsive: false
    description: ""
