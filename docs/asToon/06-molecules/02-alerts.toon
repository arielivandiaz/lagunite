    selector: .alert > svg
    id: #06-02-01
    category: null
    properties[4]: flex,width,height,margin-top
    cssRule: "flex: none\nwidth: 1.125rem\nheight: 1.125rem\nmargin-top: 0.0625rem"
    responsive: false
    description: "Icon layout only when the alert starts with an icon: plain text + <code> must stay inline"
