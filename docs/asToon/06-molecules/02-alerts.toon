    properties[8]: padding,border,border-radius,background,box-shadow,color,font-size,line-height
    cssRule: "padding: 0.875rem var(--space-4)\nborder: var(--border-width-s) solid var(--color-border)\nborder-radius: var(--radius-lg)\nbackground: var(--color-surface-raised)\nbox-shadow: var(--shadow-xs)\ncolor: var(--color-text-base)\nfont-size: var(--font-size-s)\nline-height: 1.5"
    responsive: false
    description: ── Alert base ───────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: ".alert:has(> svg:first-child)"
    id: #06-02-01
    category: null
    properties[3]: display,align-items,gap
    cssRule: "display: flex\nalign-items: flex-start\ngap: var(--space-3)"
    responsive: false
    description: "Icon layout only when the alert starts with an icon: plain text + <code> must stay inline"
  - type: selector
