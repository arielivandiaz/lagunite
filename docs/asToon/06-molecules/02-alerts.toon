  - type: selector
    selectorType: class
    selector: .alert-close
    id: #06-02-03
    category: null
    properties[12]: position,top,right,padding,border,background,font,line-height,cursor,opacity,transform,transition
    cssRule: "position: absolute\ntop: 50%\nright: var(--space-3)\npadding: 0\nborder: none\nbackground: none\nfont: inherit\nline-height: 1\ncursor: pointer\nopacity: 0.7\ntransform: translateY(-50%)\ntransition: opacity 0.2s ease"
    responsive: false
    description: ── Dismissible alert + close ───────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: ".alert-close:hover"
    id: #06-02-03
    category: null
    properties[1]: opacity
    cssRule: "opacity: 1"
    responsive: false
    description: ── Dismissible alert + close ───────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .toast
    id: #06-02-04
    category: null
    properties[11]: position,right,bottom,z-index,min-width,max-width,padding,background,border,border-radius,box-shadow
    cssRule: "position: fixed\nright: var(--space-4)\nbottom: var(--space-4)\nz-index: 1000\nmin-width: 18rem\nmax-width: min(24rem, calc(100vw - var(--space-8)))\npadding: var(--space-3) var(--space-4)\nbackground: var(--color-bg)\nborder: var(--border-width-s) solid var(--color-border)\nborder-radius: var(--radius-m)\nbox-shadow: var(--shadow-l)"
    responsive: true
    description: ── Toast ───────────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .snackbar
    id: #06-02-05
    category: null
    properties[18]: position,left,bottom,z-index,display,align-items,justify-content,gap,width,padding,color,background,border-radius,box-shadow,opacity,pointer-events,transform,transition
    cssRule: "position: fixed\nleft: 50%\nbottom: var(--space-4)\nz-index: 1005\ndisplay: inline-flex\nalign-items: center\njustify-content: space-between\ngap: var(--space-3)\nwidth: min(calc(100vw - var(--space-6)), 34rem)\npadding: var(--space-3) var(--space-4)\ncolor: var(--gray-50)\nbackground: var(--gray-900)\nborder-radius: var(--radius-full)\nbox-shadow: var(--shadow-l)\nopacity: 0\npointer-events: none\ntransform: translateX(-50%) translateY(calc(100% + var(--space-4)))\ntransition:\n    opacity 0.24s ease,\n    transform 0.24s ease"
    responsive: false
    description: ── Snackbar ───────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .snackbar.open
    id: #06-02-05
    category: null
    properties[3]: opacity,pointer-events,transform
    cssRule: "opacity: 1\npointer-events: auto\ntransform: translateX(-50%) translateY(0)"
    responsive: false
    description: ── Snackbar ───────────────────────────────────────────────────────────
