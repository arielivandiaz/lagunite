  - type: selector
    selectorType: class
    selector: .toast
    id: #06-02-04
    category: null
    properties[14]: position,right,bottom,z-index,min-width,max-width,padding,color,background,"-webkit-backdrop-filter",backdrop-filter,border,border-radius,box-shadow
    cssRule: "position: fixed\nright: var(--space-4)\nbottom: var(--space-4)\nz-index: 1000\nmin-width: 18rem\nmax-width: min(24rem, calc(100vw - var(--space-8)))\npadding: var(--space-3) var(--space-4)\ncolor: var(--color-text-base)\nbackground: var(--color-glass)\n-webkit-backdrop-filter: blur(var(--blur-md)) saturate(160%)\nbackdrop-filter: blur(var(--blur-md)) saturate(160%)\nborder: var(--border-width-s) solid var(--color-border-strong)\nborder-radius: var(--radius-lg)\nbox-shadow: inset 0 1px 0 var(--color-highlight), var(--shadow-l)"
    responsive: true
    description: ── Toast ───────────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .toast-stack
    id: #06-02-04b
    category: null
    properties[9]: position,right,bottom,z-index,display,flex-direction,gap,align-items,pointer-events
    cssRule: "position: fixed\nright: var(--space-4)\nbottom: var(--space-4)\nz-index: 1000\ndisplay: flex\nflex-direction: column-reverse\ngap: var(--space-2)\nalign-items: flex-end\npointer-events: none"
    responsive: false
    description: "* Progressive: popover=\"manual\" toast stack (no light-dismiss).\n * Existing `.toast` fixed shell remains the default path."
