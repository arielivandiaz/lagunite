    id: #06-12-02
    category: null
    properties[18]: display,align-items,justify-content,gap,padding,margin,font-family,font-size,font-weight,line-height,color,text-decoration,white-space,background,border,border-radius,cursor,transition
    cssRule: "display: inline-flex\nalign-items: center\njustify-content: center\ngap: var(--space-2)\npadding: var(--space-2) var(--space-4)\nmargin: 0\nfont-family: var(--font-sans)\nfont-size: var(--font-size-s)\nfont-weight: var(--font-weight-medium)\nline-height: 1.4\ncolor: var(--gray-600)\ntext-decoration: none\nwhite-space: nowrap\nbackground: transparent\nborder: none\nborder-radius: var(--radius-m) var(--radius-m) 0 0\ncursor: pointer\ntransition:\r\n    background-color 0.2s ease,\r\n    color 0.2s ease,\r\n    box-shadow 0.2s ease"
    responsive: false
    description: ── Tab triggers ────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: ".tab-button:hover"
    id: #06-12-02
