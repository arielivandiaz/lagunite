    selectorType: class
    selector: ".tab-button:focus-visible"
    id: #06-12-02
    category: null
    properties[2]: outline,outline-offset
    cssRule: "outline: var(--border-width-md) solid var(--color-primary)\noutline-offset: 2px"
    responsive: false
    description: ── Tab triggers ────────────────────────────────────────────────────────
  - type: selector
