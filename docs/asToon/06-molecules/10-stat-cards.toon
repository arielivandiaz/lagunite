    cssRule: "font-size: 0.68rem\nfont-weight: 700\nletter-spacing: 0.09em\ntext-transform: uppercase\ncolor: var(--stat-label)\ntransition: color 0.35s"
    responsive: false
    description: "==========\r\n   06-molecules / 10-stat-cards.css\r\n   Glassy stat cards for dashboard metrics, comparisons, progress, and split KPIs.\r\n   =========="
