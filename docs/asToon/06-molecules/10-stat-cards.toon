    selector: .stat-split
    id: #06-10-05
    category: null
    properties[7]: display,grid-template-columns,gap,margin-top,padding-top,border-top,transition
    cssRule: "display: grid\ngrid-template-columns: 1fr 1fr\ngap: 0.75rem\nmargin-top: 4px\npadding-top: 8px\nborder-top: 1px solid var(--stat-divider)\ntransition: border-color 0.35s"
    responsive: false
    description: "==========\r\n   06-molecules / 10-stat-cards.css\r\n   Glassy stat cards for dashboard metrics, comparisons, progress, and split KPIs.\r\n   =========="
