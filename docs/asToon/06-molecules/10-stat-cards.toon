  - type: selector
    selectorType: class
    selector: .stat-card
    id: #06-10-02
    category: null
    properties[14]: position,overflow,display,flex-direction,gap,padding,border,border-radius,background,color,box-shadow,"-webkit-backdrop-filter",backdrop-filter,transition
    cssRule: "position: relative\noverflow: hidden\ndisplay: flex\nflex-direction: column\ngap: 0.5rem\npadding: 1.25rem 1.5rem\nborder: 1px solid var(--stat-card-border)\nborder-radius: var(--radius-xl)\nbackground: var(--stat-card-bg)\ncolor: var(--stat-text)\nbox-shadow: inset 0 1px 0 rgb(255 255 255 / 10%), var(--stat-shadow)\n-webkit-backdrop-filter: blur(var(--blur-sm))\nbackdrop-filter: blur(var(--blur-sm))\ntransition:\r\n    background 0.4s,\r\n    border-color 0.4s,\r\n    color 0.4s,\r\n    box-shadow 0.4s"
    responsive: false
    description: "==========\r\n   06-molecules / 10-stat-cards.css\r\n   Glassy stat cards for dashboard metrics, comparisons, progress, and split KPIs.\r\n   =========="
