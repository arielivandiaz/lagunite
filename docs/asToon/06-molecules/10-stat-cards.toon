    selector: .stat-score-range
    id: #06-10-05
    category: null
    properties[6]: display,justify-content,margin-top,font-size,color,transition
    cssRule: "display: flex\njustify-content: space-between\nmargin-top: 3px\nfont-size: 0.6rem\ncolor: var(--stat-label)\ntransition: color 0.35s"
    responsive: false
