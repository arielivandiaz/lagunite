    cssRule: "font-family: var(--font-display)\nfont-size: 1.25rem\nfont-weight: 800\nline-height: 1.1\nletter-spacing: -0.02em\nfont-variant-numeric: tabular-nums\ntransition: color 0.4s"
    responsive: false
