    cssRule: "inset: auto\nmargin: 0\nposition: fixed\nposition-anchor: --lagunite-tip\nposition-area: block-start\nposition-try-fallbacks: flip-block, flip-inline\nmax-width: 16rem\nborder: none"
    responsive: false
    description: ── Placement variants ───────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .tooltip-hint
    id: #06-04-02
    category: null
    properties[7]: inset,margin,position,position-area,position-try-fallbacks,max-width,border
    cssRule: "inset: auto\nmargin: 0\nposition: fixed\nposition-area: block-end\nposition-try-fallbacks: flip-block, flip-inline\nmax-width: 16rem\nborder: none"
    responsive: false
    description: "* Interest invokers (popover=\"hint\" + interestfor) — limited availability.\n   * Chrome/visual only here. Pair each trigger/hint with unique\n   * anchor-name / position-anchor (inline or per-instance) for polyfills;\n   * native interestfor can use the implicit anchor.\n   * Do NOT set role=\"tooltip\" / aria-describedby on the trigger — UA wires it."