  - type: selector
    selectorType: pseudo
    selector: "[data-tooltip]::after"
    id: #06-04-01
    category: null
    properties[10]: content,position,bottom,left,z-index,white-space,pointer-events,opacity,transform,transition
    cssRule: "content: attr(data-tooltip)\nposition: absolute\nbottom: calc(100% + var(--space-2))\nleft: 50%\nz-index: 200\nwhite-space: nowrap\npointer-events: none\nopacity: 0\ntransform: translate(-50%, 4px)\ntransition:\n    opacity var(--dur) var(--ease-out),\n    transform var(--dur) var(--ease-out)"
    responsive: false
    description: ── Tooltip anchor + bubble ───────────────────────────────────────────────
  - type: selector
    selectorType: pseudo-hover
    selector: "[data-tooltip]:hover::after"
    id: #06-04-01
    category: null
    properties[2]: opacity,transform
    cssRule: "opacity: 1\ntransform: translate(-50%, 0)"
    responsive: false
    description: ── Tooltip anchor + bubble ───────────────────────────────────────────────
  - type: selector
    selectorType: pseudo
    selector: "[data-tooltip]:focus-visible::after"
    id: #06-04-01
    category: null
    properties[2]: opacity,transform
    cssRule: "opacity: 1\ntransform: translate(-50%, 0)"
    responsive: false
    description: ── Tooltip anchor + bubble ───────────────────────────────────────────────
