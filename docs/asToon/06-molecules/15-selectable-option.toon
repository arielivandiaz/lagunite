content[24]:
  - type: selector
    selectorType: class
    selector: .selectable-option
    id: #06-15-01
    category: null
    properties[13]: position,display,align-items,justify-content,gap,width,padding,border,border-radius,background,cursor,user-select,transition
    cssRule: "position: relative\ndisplay: flex\nalign-items: center\njustify-content: space-between\ngap: var(--space-3)\nwidth: 100%\npadding: var(--space-3) var(--space-4)\nborder: 2px solid var(--color-border)\nborder-radius: var(--radius-xl)\nbackground: transparent\ncursor: pointer\nuser-select: none\ntransition: border-color 0.2s ease, background 0.2s ease"
    responsive: false
    description: ── Base container ─────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: ".selectable-option:hover"
    id: #06-15-01
    category: null
    properties[1]: border-color
    cssRule: "border-color: var(--color-primary)"
    responsive: false
    description: ── Base container ─────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: ".selectable-option input[type=\"checkbox\"]"
    id: #06-15-01
    category: null
    properties[9]: position,width,height,padding,margin,overflow,clip,white-space,border
    cssRule: "position: absolute\nwidth: 1px\nheight: 1px\npadding: 0\nmargin: -1px\noverflow: hidden\nclip: rect(0, 0, 0, 0)\nwhite-space: nowrap\nborder: 0"
    responsive: false
    description: Visually hidden but focusable native control
  - type: selector
    selectorType: class
    selector: ".selectable-option input[type=\"radio\"]"
    id: #06-15-01
    category: null
    properties[9]: position,width,height,padding,margin,overflow,clip,white-space,border
    cssRule: "position: absolute\nwidth: 1px\nheight: 1px\npadding: 0\nmargin: -1px\noverflow: hidden\nclip: rect(0, 0, 0, 0)\nwhite-space: nowrap\nborder: 0"
    responsive: false
    description: Visually hidden but focusable native control
  - type: selector
    selectorType: class
    selector: .selectable-option-label
    id: #06-15-02
    category: null
    properties[6]: font-family,font-size,font-weight,color,flex,min-width
    cssRule: "font-family: var(--font-headers)\nfont-size: var(--font-size-base)\nfont-weight: var(--font-weight-medium)\ncolor: var(--color-text-base)\nflex: 1\nmin-width: 0"
    responsive: false
    description: ── Label ──────────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .selectable-option-indicator
    id: #06-15-03
    category: null
    properties[9]: flex-shrink,width,height,border-radius,border,display,align-items,justify-content,transition
    cssRule: "flex-shrink: 0\nwidth: 1.5rem\nheight: 1.5rem\nborder-radius: var(--radius-full)\nborder: 2px solid var(--color-border)\ndisplay: flex\nalign-items: center\njustify-content: center\ntransition: background 0.2s ease, border-color 0.2s ease"
    responsive: false
    description: ── Indicator (circle with checkmark) ──────────────────────────────────
  - type: selector
    selectorType: class
    selector: ".selectable-option-indicator::after"
    id: #06-15-03
    category: null
    properties[7]: content,display,width,height,border,border-width,transform
    cssRule: "content: \"\"\ndisplay: none\nwidth: 6px\nheight: 11px\nborder: solid var(--color-on-fill, var(--color-text-alt))\nborder-width: 0 2.5px 2.5px 0\ntransform: rotate(45deg) translateY(-1px)"
    responsive: false
    description: ── Indicator (circle with checkmark) ──────────────────────────────────
  - type: selector
    selectorType: class
    selector: ".selectable-option:has(input:checked)"
    id: #06-15-04
