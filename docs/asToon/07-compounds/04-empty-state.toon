    cssRule: "width: 3.5rem\nheight: 3.5rem\nborder-radius: var(--radius-lg)\ndisplay: inline-flex\nalign-items: center\njustify-content: center\nfont-size: 1.4rem\ncolor: var(--color-primary-text)\nbackground: var(--color-primary-soft)\nborder: 0\nbox-shadow: inset 0 1px 0 var(--color-highlight), inset 0 0 0 1px rgba(var(--color-primary-rgb), 0.18)"
    responsive: false
    description: ── Base container and structure ────────────────────────────────────────
