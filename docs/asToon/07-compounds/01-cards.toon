folder: 07-compounds
file: 01-cards.css
lastUpdated: 2026-09-23
hasResponsive: false
totalSelectors: 61
content[61]:
  - type: selector
    selectorType: class
    selector: .card
    id: #07-01-01
    category: null
    properties[5]: background,border,border-radius,overflow,transition
    cssRule: "background: var(--color-bg)\nborder: var(--border-width-s) solid var(--color-border)\nborder-radius: var(--radius-m)\noverflow: hidden\ntransition: box-shadow 0.2s"
    responsive: false
    description: ── Card base ────────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .card-header
    id: #07-01-02
    category: null
    properties[3]: padding,border-bottom,font-weight
    cssRule: "padding: var(--space-4)\nborder-bottom: var(--border-width-s) solid var(--color-border)\nfont-weight: var(--font-weight-bold)"
    responsive: false
    description: ── Card regions ─────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .card-body
    id: #07-01-02
    category: null
    properties[1]: padding
    cssRule: "padding: var(--space-4)"
    responsive: false
    description: ── Card regions ─────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .card-footer
    id: #07-01-02
    category: null
    properties[3]: padding,border-top,background
    cssRule: "padding: var(--space-3) var(--space-4)\nborder-top: var(--border-width-s) solid var(--color-border)\nbackground: rgb(0 0 0 / 2%)"
    responsive: false
    description: ── Card regions ─────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .card-img-top
    id: #07-01-02
    category: null
    properties[3]: width,display,border-radius
    cssRule: "width: 100%\ndisplay: block\nborder-radius: var(--radius-m) var(--radius-m) 0 0"
    responsive: false
    description: ── Card regions ─────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .card-img-bottom
    id: #07-01-02
    category: null
    properties[3]: width,display,border-radius
    cssRule: "width: 100%\ndisplay: block\nborder-radius: 0 0 var(--radius-m) var(--radius-m)"
    responsive: false
    description: ── Card regions ─────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .card-title
    id: #07-01-02
    category: null
    properties[3]: font-size,font-weight,margin-bottom
    cssRule: "font-size: var(--font-size-l)\nfont-weight: var(--font-weight-bold)\nmargin-bottom: var(--space-2)"
    responsive: false
    description: ── Card regions ─────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .card-text
    id: #07-01-02
    category: null
    properties[2]: color,font-size
    cssRule: "color: var(--gray-600)\nfont-size: var(--font-size-base)"
    responsive: false
    description: ── Card regions ─────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .night .card-text
    id: #07-01-02
    category: null
    properties[1]: color
    cssRule: "/* gray-600 is too dark on .night .card (gray-800) */\ncolor: var(--gray-400)"
    responsive: false
    description: ── Card regions ─────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .card-elevated
    id: #07-01-03
    category: null
    properties[1]: box-shadow
    cssRule: "box-shadow: var(--shadow-m)"
    responsive: false
    description: "Default `.card` is flat (border only). Elevation is opt-in via `.card-elevated`.\n   Anti-slop: ≤1 elevated card per view unless a clear floating job (modal-like)."
  - type: selector
    selectorType: class
    selector: .card-flat
    id: #07-01-03
    category: null
    properties[2]: border,background
    cssRule: "border: none\nbackground: transparent"
    responsive: false
    description: "Default `.card` is flat (border only). Elevation is opt-in via `.card-elevated`.\n   Anti-slop: ≤1 elevated card per view unless a clear floating job (modal-like)."
  - type: selector
    selectorType: class
    selector: .card-hover
    id: #07-01-03
    category: null
    properties[1]: transition
    cssRule: "transition: box-shadow 0.2s, transform 0.2s"
    responsive: false
    description: "Default `.card` is flat (border only). Elevation is opt-in via `.card-elevated`.\n   Anti-slop: ≤1 elevated card per view unless a clear floating job (modal-like)."
  - type: selector
    selectorType: class
    selector: ".card-hover:hover"
    id: #07-01-03
    category: null
    properties[2]: box-shadow,transform
    cssRule: "box-shadow: var(--shadow-l)\ntransform: translateY(-2px)"
    responsive: false
    description: "Default `.card` is flat (border only). Elevation is opt-in via `.card-elevated`.\n   Anti-slop: ≤1 elevated card per view unless a clear floating job (modal-like)."
  - type: selector
    selectorType: class
    selector: .card-primary
    id: #07-01-04
    category: null
    properties[1]: border-color
    cssRule: "border-color: var(--color-primary)"
    responsive: false
    description: ── Card semantic variants (primary) ─────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .card-primary .card-header
    id: #07-01-04
    category: null
    properties[2]: background,color
    cssRule: "background: var(--color-primary)\ncolor: var(--color-text-alt)"
    responsive: false
    description: ── Card semantic variants (primary) ─────────────────────────────────────
