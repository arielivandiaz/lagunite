  - type: selector
    selectorType: class
    selector: .card-accent-primary
    id: #07-01-06
    category: null
    properties[4]: border-top-color,border-right-color,border-bottom-color,border-left-width
    cssRule: "border-top-color: transparent\nborder-right-color: transparent\nborder-bottom-color: transparent\nborder-left-width: 4px"
    responsive: false
    description: "@title Card accent variants\n  @desc  Highlights only the left border with a semantic or palette color.\n         Combine with .card. The other three borders become transparent.\n  @example\n    <div class=\"card card-accent-primary\"><div class=\"card-body\">...</div></div>\n    <div class=\"card card-accent-success\"><div class=\"card-body\">...</div></div>\n  @classes\n    .card-accent-primary   | left border in primary color\n    .card-accent-secondary | left border in secondary color\n    .card-accent-tertiary  | left border in tertiary color\n    .card-accent-success   | left border in success color\n    .card-accent-warning   | left border in warning color\n    .card-accent-error     | left border in error color"
  - type: selector
    selectorType: class
    selector: .card-accent-secondary
    id: #07-01-06
    category: null
    properties[4]: border-top-color,border-right-color,border-bottom-color,border-left-width
    cssRule: "border-top-color: transparent\nborder-right-color: transparent\nborder-bottom-color: transparent\nborder-left-width: 4px"
    responsive: false
