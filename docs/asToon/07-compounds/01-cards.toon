    id: #07-01-07
    category: null
    properties[2]: display,flex-direction
    cssRule: "display: flex\nflex-direction: row"
    responsive: false
    description: ── Card horizontal layout & groups ──────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .card-horizontal .card-img
    id: #07-01-07
    category: null
    properties[2]: width,object-fit
    cssRule: "width: 40%\nobject-fit: cover"
    responsive: false
    description: ── Card horizontal layout & groups ──────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .card-group
    id: #07-01-07
    category: null
    properties[3]: display,gap,grid-template-columns
    cssRule: "display: grid\ngap: var(--space-4)\ngrid-template-columns: repeat(auto-fill, minmax(18rem, 1fr))"
    responsive: false
    description: ── Card horizontal layout & groups ──────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .night .card
    id: #07-01-07
    category: null
    properties[2]: background,border-color
    cssRule: "background: var(--gray-800)\nborder-color: var(--gray-700)"
    responsive: false
    description: ── Night mode & responsive ──────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .card-state
    id: #07-01-08
    category: null
    properties[1]: transition
    cssRule: "transition:\n    border-color 0.2s ease,\n    box-shadow 0.2s ease,\n    background-color 0.2s ease"
    responsive: false
    description: "* Opt-in parent styling from child state (:has).\n * Prefer scoped containers — do not put on body."
  - type: selector
    selectorType: class
    selector: ".card-state:has(:focus-within)"
    id: #07-01-08
    category: null
    properties[2]: border-color,box-shadow
    cssRule: "border-color: var(--color-primary)\nbox-shadow: var(--shadow-m)"
    responsive: false
    description: "* Opt-in parent styling from child state (:has).\n * Prefer scoped containers — do not put on body."
  - type: selector
    selectorType: class
    selector: ".card-state:has(input:checked)"
    id: #07-01-08
    category: null
    properties[2]: border-color,background
    cssRule: "border-color: var(--color-primary)\nbackground: rgba(var(--color-primary-rgb), 0.06)"
    responsive: false
    description: "* Opt-in parent styling from child state (:has).\n * Prefer scoped containers — do not put on body."
  - type: selector
    selectorType: class
    selector: ".night .card-state:has(input:checked)"
    id: #07-01-08
    category: null
    properties[1]: background
    cssRule: "background: rgba(var(--color-primary-rgb), 0.14)"
    responsive: false
    description: "* Opt-in parent styling from child state (:has).\n * Prefer scoped containers — do not put on body."
  - type: selector
    selectorType: class
    selector: .card-media
    id: #07-01-09
    category: null
    properties[4]: display,flex-direction,gap,align-items
    cssRule: "display: flex\nflex-direction: column\ngap: var(--space-3)\nalign-items: stretch"
    responsive: false
    description: "* Content-based layout: row when media child present.\n * Fallback class .has-image for @supports not :has()."
  - type: selector
    selectorType: class
    selector: .card-media > .card-media-body
    id: #07-01-09
    category: null
    properties[2]: flex,min-width
    cssRule: "flex: 1\nmin-width: 0"
    responsive: false
    description: "* Content-based layout: row when media child present.\n * Fallback class .has-image for @supports not :has()."
  - type: selector
    selectorType: class
    selector: ".card-media:has(> img)"
    id: #07-01-09
    category: null
    properties[2]: flex-direction,align-items
    cssRule: "flex-direction: row\nalign-items: center"
    responsive: false
    description: "* Content-based layout: row when media child present.\n * Fallback class .has-image for @supports not :has()."
  - type: selector
    selectorType: class
    selector: ".card-media:has(> .card-img)"
    id: #07-01-09
    category: null
    properties[2]: flex-direction,align-items
    cssRule: "flex-direction: row\nalign-items: center"
    responsive: false
    description: "* Content-based layout: row when media child present.\n * Fallback class .has-image for @supports not :has()."
  - type: selector
    selectorType: class
    selector: ".card-media:has(> .card-img-top)"
    id: #07-01-09
    category: null
    properties[2]: flex-direction,align-items
    cssRule: "flex-direction: row\nalign-items: center"
    responsive: false
    description: "* Content-based layout: row when media child present.\n * Fallback class .has-image for @supports not :has()."
  - type: selector
    selectorType: class
    selector: .card-media.has-image
    id: #07-01-09
    category: null
    properties[2]: flex-direction,align-items
    cssRule: "flex-direction: row\nalign-items: center"
    responsive: false
    description: "* Content-based layout: row when media child present.\n * Fallback class .has-image for @supports not :has()."
  - type: selector
    selectorType: class
    selector: ".card-media:has(> img) > img"
    id: #07-01-09
    category: null
    properties[6]: width,max-width,height,flex-shrink,object-fit,border-radius
    cssRule: "width: 7.5rem\nmax-width: 40%\nheight: auto\nflex-shrink: 0\nobject-fit: cover\nborder-radius: var(--radius-s)"
    responsive: false
    description: "* Content-based layout: row when media child present.\n * Fallback class .has-image for @supports not :has()."
