  - type: selector
    selectorType: complex
    selector: dialog.modal
    id: #07-02-07
    category: null
    properties[9]: border,padding,margin,opacity,transform,transition-property,transition-duration,transition-timing-function,transition-behavior
    cssRule: "border: none\npadding: 0\nmargin: auto\nopacity: 0\ntransform: scale(0.95)\ntransition-property: opacity, transform, display, overlay\ntransition-duration: 0.3s\ntransition-timing-function: ease-out\ntransition-behavior: allow-discrete"
    responsive: false
    description: "* Native <dialog> shell — same .modal / regions / sizes.\n * Prefer showModal() + closedby / invoker commands over .modal-overlay when Baseline allows.\n * <!-- GAP: popover surface utilities — use .card inside [popover] for now -->"
  - type: selector
