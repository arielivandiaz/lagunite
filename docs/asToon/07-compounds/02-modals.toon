content[22]:
  - type: selector
    selectorType: class
    selector: .modal-overlay
    id: #07-02-01
    category: null
    properties[12]: position,inset,background,"-webkit-backdrop-filter",backdrop-filter,display,align-items,justify-content,z-index,opacity,pointer-events,transition
    cssRule: "position: fixed\ninset: 0\nbackground: var(--color-overlay)\n-webkit-backdrop-filter: blur(var(--blur-sm))\nbackdrop-filter: blur(var(--blur-sm))\ndisplay: flex\nalign-items: center\njustify-content: center\nz-index: 1000\nopacity: 0\npointer-events: none\ntransition: opacity var(--dur-slow) var(--ease-out)"
    responsive: false
    description: ── Modal overlay ────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .modal-overlay.open
    id: #07-02-01
    category: null
    properties[2]: opacity,pointer-events
    cssRule: "opacity: 1\npointer-events: auto"
    responsive: false
    description: ── Modal overlay ────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .modal
    id: #07-02-02
    category: null
    properties[10]: color,background,border-radius,box-shadow,width,max-width,max-height,overflow-y,transform,transition
    cssRule: "color: var(--color-text-base)\nbackground: var(--color-surface-raised)\nborder-radius: var(--radius-2xl)\nbox-shadow: inset 0 1px 0 var(--color-highlight), 0 0 0 1px var(--color-border), var(--shadow-xl)\nwidth: 90%\nmax-width: 32rem\nmax-height: 90vh\noverflow-y: auto\ntransform: scale(0.96) translateY(8px)\ntransition: transform var(--dur-slow) var(--ease-spring)"
    responsive: false
    description: ── Modal shell ──────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .modal-overlay.open .modal
    id: #07-02-02
    category: null
    properties[1]: transform
    cssRule: "transform: scale(1) translateY(0)"
    responsive: false
    description: ── Modal shell ──────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .modal-header
    id: #07-02-03
    category: null
    properties[4]: padding,display,align-items,justify-content
    cssRule: "padding: var(--space-5) var(--space-6) var(--space-3)\ndisplay: flex\nalign-items: center\njustify-content: space-between"
    responsive: false
    description: ── Modal header ─────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .modal-title
    id: #07-02-03
    category: null
    properties[4]: font-family,font-size,font-weight,letter-spacing
    cssRule: "font-family: var(--font-display)\nfont-size: var(--font-size-xl)\nfont-weight: var(--font-weight-semibold)\nletter-spacing: var(--letter-spacing-title)"
    responsive: false
    description: ── Modal header ─────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .modal-close
    id: #07-02-03
    category: null
    properties[13]: display,place-items,width,height,padding,background,border,border-radius,cursor,font-size,line-height,color,transition
    cssRule: "display: inline-grid\nplace-items: center\nwidth: 2rem\nheight: 2rem\npadding: 0\nbackground: var(--color-surface-muted)\nborder: none\nborder-radius: var(--radius-full)\ncursor: pointer\nfont-size: 1.125rem\nline-height: 1\ncolor: var(--color-text-muted)\ntransition: background var(--dur) var(--ease-out), color var(--dur) var(--ease-out)"
    responsive: false
    description: ── Modal header ─────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: ".modal-close:hover"
    id: #07-02-03
