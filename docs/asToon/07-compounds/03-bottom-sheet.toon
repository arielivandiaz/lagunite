content[16]:
  - type: selector
    selectorType: class
    selector: .bottom-sheet-overlay
    id: #07-03-01
    category: null
    properties[13]: position,inset,display,align-items,justify-content,padding,background,"-webkit-backdrop-filter",backdrop-filter,z-index,opacity,pointer-events,transition
    cssRule: "position: fixed\ninset: 0\ndisplay: flex\nalign-items: flex-end\njustify-content: center\npadding: var(--space-4) var(--space-3) 0\nbackground: var(--color-overlay)\n-webkit-backdrop-filter: blur(var(--blur-sm))\nbackdrop-filter: blur(var(--blur-sm))\nz-index: 1010\nopacity: 0\npointer-events: none\ntransition: opacity 0.28s ease"
    responsive: false
    description: ── Bottom sheet overlay ────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .bottom-sheet-overlay.open
    id: #07-03-01
    category: null
    properties[2]: opacity,pointer-events
    cssRule: "opacity: 1\npointer-events: auto"
    responsive: false
    description: ── Bottom sheet overlay ────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .bottom-sheet
    id: #07-03-02
    category: null
    properties[13]: width,max-height,display,flex-direction,color,background,border,border-bottom,border-radius,box-shadow,transform,transition,overflow
    cssRule: "width: min(100%, 42rem)\nmax-height: min(82vh, 42rem)\ndisplay: flex\nflex-direction: column\ncolor: var(--color-text-base)\nbackground: var(--color-surface-raised)\nborder: var(--border-width-s) solid var(--color-border)\nborder-bottom: none\nborder-radius: var(--radius-2xl) var(--radius-2xl) 0 0\nbox-shadow: inset 0 1px 0 var(--color-highlight), var(--shadow-xl)\ntransform: translateY(100%)\ntransition: transform var(--dur-slow) var(--ease-out)\noverflow: hidden"
    responsive: false
    description: ── Bottom sheet shell ──────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .bottom-sheet-overlay.open .bottom-sheet
    id: #07-03-02
    category: null
    properties[1]: transform
    cssRule: "transform: translateY(0)"
    responsive: false
    description: ── Bottom sheet shell ──────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .bottom-sheet-handle
    id: #07-03-02
    category: null
    properties[6]: width,height,margin,border-radius,background,flex-shrink
    cssRule: "width: 3rem\nheight: 0.3125rem\nmargin: var(--space-3) auto var(--space-1)\nborder-radius: var(--radius-full)\nbackground: var(--color-border-strong)\nflex-shrink: 0"
    responsive: false
    description: ── Bottom sheet shell ──────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .bottom-sheet-header
    id: #07-03-03
