    properties[5]: display,align-items,justify-content,gap,padding
    cssRule: "display: flex\nalign-items: center\njustify-content: space-between\ngap: var(--space-3)\npadding: var(--space-2) var(--space-5) var(--space-3)"
    responsive: false
    description: ── Regions ─────────────────────────────────────────────────────────────
  - type: selector
    selectorType: class
    selector: .bottom-sheet-title
    id: #07-03-03
    category: null
