    {
      "type": "selector",
      "selectorType": "class",
      "selector": ".dnd-canvas",
      "id": "#08-09-01",
      "category": null,
      "properties": [
        "position",
        "display",
        "width",
        "border",
        "border-radius",
        "background-color",
        "background-image",
        "background-size",
        "background-position",
        "overflow",
        "user-select",
        "touch-action"
      ],
      "cssRule": "/* Layout */\nposition: relative\ndisplay: block\nwidth: 100%\n/* Appearance — dot grid (Figma-style) */\nborder: var(--border-width-s) solid var(--color-border)\nborder-radius: var(--radius-l)\nbackground-color: var(--gray-50)\nbackground-image: radial-gradient(circle, var(--gray-300) 1.5px, transparent 1.5px)\nbackground-size: var(--dnd-grid-major, 24px) var(--dnd-grid-major, 24px)\nbackground-position: 0 0\n/* Sizing */\noverflow: hidden\n/* Interaction */\nuser-select: none\ntouch-action: none",
      "responsive": false,
      "description": "Drag & Drop Canvas Organism\n   Grid-based spatial canvas for draggable nodes.\n   Supports snap-to-grid and pointer-based interactions.\n   Works with .dnd-node molecules inside."
    },
    {
      "type": "selector",
      "selectorType": "class",
      "selector": ".dnd-canvas:focus-within",
      "id": "#08-09-01",
      "category": null,
