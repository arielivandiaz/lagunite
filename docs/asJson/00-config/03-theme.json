      "cssRule": ":root {\r\n  /*== Color Assignments ==*/\r\n  --color-primary: #2476ff;\r\n  --color-primary-light: #5e9aff;\r\n  --color-primary-dark: #0965ff;\r\n\r\n  --color-secondary: #747474;\r\n  --color-secondary-light: #333;\r\n  --color-secondary-dark: #292929;\r\n\r\n  --color-tertiary: #f97316;\r\n  --color-tertiary-light: #ffa261;\r\n  --color-tertiary-dark: #c95300;\r\n\r\n  --color-almost-black: #333;\r\n  --color-almost-white: #fcfcfc;\r\n\r\n  --color-success: #009112;\r\n  --color-success-light: #98FF98;\r\n  --color-warning: #ff9017;\r\n  --color-warning-light: #FFEAD5;\r\n  --color-error: #fa3434;\r\n  --color-error-light: #FDD0D0;\r\n\r\n  /*== Text Colors ==*/\r\n  --color-text-base: #333;\r\n  --color-text-alt: #fff;\r\n\r\n  /*== Background Colors ==*/\r\n  --color-bg: #eee;\r\n  --color-bg-alt: #222;\r\n\r\n  --bg-primary: linear-gradient(0deg, #0965ff 0%, #2476ff 100%);\r\n  --bg-secondary: linear-gradient(0deg, #292929 0%, #747474 100%);\r\n  --bg-tertiary: linear-gradient(0deg, #bbb 0%, #fff 100%);\r\n\r\n  --color-border: var(--gray-200);\r\n  --color-border-hover: var(--gray-300);\r\n\r\n\r\n  /*== Gradients ==*/\r\n  --bg-gradient-1: linear-gradient(0deg, #2476ff 0%, #5e9aff 100%);\r\n  --bg-gradient-2: linear-gradient(0deg, #fff 0%, #5e9aff 100%);\r\n  --bg-gradient-3: linear-gradient(0deg, #0965ff 0%, #2476ff 100%);\r\n  --bg-gradient-4: linear-gradient(\r\n    180deg,\r\n    rgba(94, 154, 255, 1) 0%,\r\n    rgba(36, 118, 255, 1) 50%,\r\n    rgba(0, 90, 238, 1) 100%\r\n  );\r\n  --background-gradient-5: radial-gradient(\r\n    circle,\r\n    rgba(94, 154, 255, 1) 0%,\r\n    rgba(36, 118, 255, 1) 100%\r\n  );\r\n  --bg-gradient-6: radial-gradient(\r\n    circle,\r\n    rgba(238, 238, 238, 1) 0%,\r\n    rgba(193, 216, 255, 1) 100%\r\n  );\r\n  --bg-gradient-7: repeating-linear-gradient(\r\n    45deg,\r\n    #2476ff,\r\n    #5e9aff 20px,\r\n    #fff 20px,\r\n    #ccc 32px\r\n  );\r\n  --background-gradient-8: repeating-linear-gradient(\r\n    45deg,\r\n    #5e9aff,\r\n    #0965ff 20px,\r\n    #000 20px,\r\n    #444 32px\r\n  );\r\n\r\n  /*== Borders ==*/\r\n  --border: 2px solid #2476ff;\r\n  --border-light: 2px solid #5e9aff;\r\n  --border-dark: 2px solid #0965ff;\r\n\r\n  --border-sm: 1px solid #2476ff;\r\n  --border-sm-light: 1px solid #5e9aff;\r\n  --border-sm-dark: 1px solid #0965ff;\r\n\r\n  --border-lg: 4px solid #2476ff;\r\n  --border-lg-light: 4px solid #5e9aff;\r\n  --border-lg-dark: 4px solid #0965ff;\r\n\r\n  /*== Shadows (Composable) ==*/\r\n  --shadow-sm: 0 1px 2px 0 hsla(0, 0%, 0%, 0.05);\r\n  --shadow-md:\r\n    0 4px 6px -1px hsla(0, 0%, 0%, 0.1), 0 2px 4px -2px hsla(0, 0%, 0%, 0.1);\r\n  --shadow-lg:\r\n    0 10px 15px -3px hsla(0, 0%, 0%, 0.1), 0 4px 6px -4px hsla(0, 0%, 0%, 0.1);\r\n  --shadow-inner: inset 0 2px 4px 0 hsla(0, 0%, 0%, 0.05);\r\n}",
      "responsive": false,
      "description": ""
    }
