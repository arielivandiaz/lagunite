      "cssRule": ":root {  \r\n  /*== Neutral Palette (Gray) ==*/\r\n  --gray-50: hsl(210, 20%, 95%);\r\n  --gray-100: hsl(210, 18%, 89%);\r\n  --gray-200: hsl(210, 15%, 82%);\r\n  --gray-300: hsl(210, 13%, 70%);\r\n  --gray-400: hsl(210, 11%, 60%);\r\n  --gray-500: hsl(210, 9%, 50%);\r\n  --gray-600: hsl(210, 10%, 40%);\r\n  --gray-700: hsl(210, 12%, 30%);\r\n  --gray-800: hsl(210, 15%, 20%);\r\n  --gray-900: hsl(210, 20%, 10%);\r\n  --gray-950: hsl(210, 25%, 5%);\r\n\r\n  /*== Primary Palette (Blue) ==*/\r\n  --blue-50: hsl(210, 90%, 96%);\r\n  --blue-100: hsl(210, 90%, 90%);\r\n  --blue-200: hsl(210, 90%, 80%);\r\n  --blue-300: hsl(210, 90%, 70%);\r\n  --blue-400: hsl(210, 90%, 60%);\r\n  --blue-500: hsl(210, 90%, 50%);\r\n  --blue-600: hsl(210, 85%, 40%);\r\n  --blue-700: hsl(210, 80%, 30%);\r\n  --blue-800: hsl(210, 80%, 25%);\r\n  --blue-900: hsl(210, 85%, 20%);\r\n  --blue-950: hsl(210, 90%, 15%);\r\n\r\n  /*== Accent Palette: Green (Success) ==*/\r\n  --green-50: hsl(140, 65%, 96%);\r\n  --green-100: hsl(140, 65%, 90%);\r\n  --green-200: hsl(140, 60%, 80%);\r\n  --green-300: hsl(140, 60%, 70%);\r\n  --green-400: hsl(140, 60%, 60%);\r\n  --green-500: hsl(140, 60%, 45%);\r\n  --green-600: hsl(140, 70%, 35%);\r\n  --green-700: hsl(140, 75%, 28%);\r\n  --green-800: hsl(140, 75%, 20%);\r\n  --green-900: hsl(140, 80%, 15%);\r\n  --green-950: hsl(140, 85%, 10%);\r\n\r\n  /*== Accent Palette: Yellow (Warning) ==*/\r\n  --yellow-50: hsl(45, 95%, 96%);\r\n  --yellow-100: hsl(45, 95%, 90%);\r\n  --yellow-200: hsl(45, 90%, 80%);\r\n  --yellow-300: hsl(45, 90%, 70%);\r\n  --yellow-400: hsl(45, 90%, 60%);\r\n  --yellow-500: hsl(45, 90%, 50%);\r\n  --yellow-600: hsl(42, 85%, 45%);\r\n  --yellow-700: hsl(40, 80%, 38%);\r\n  --yellow-800: hsl(38, 75%, 30%);\r\n  --yellow-900: hsl(36, 70%, 22%);\r\n  --yellow-950: hsl(35, 65%, 15%);\r\n\r\n  /*== Accent Palette: Red (Danger) ==*/\r\n  --red-50: hsl(0, 85%, 96%);\r\n  --red-100: hsl(0, 85%, 90%);\r\n  --red-200: hsl(0, 80%, 80%);\r\n  --red-300: hsl(0, 80%, 70%);\r\n  --red-400: hsl(0, 80%, 60%);\r\n  --red-500: hsl(0, 75%, 50%);\r\n  --red-600: hsl(0, 70%, 42%);\r\n  --red-700: hsl(0, 75%, 35%);\r\n  --red-800: hsl(0, 75%, 28%);\r\n  --red-900: hsl(0, 80%, 20%);\r\n  --red-950: hsl(0, 85%, 15%);\r\n}",
      "responsive": false,
      "description": ""
    }
