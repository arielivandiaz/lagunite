{
  "name": "lagunite",
  "version": "2.0.21",
  "description": "Una librería CSS moderna y ligera, con utilidades y un sistema de diseño personalizable.",
  "type": "module",
  "main": "./dist/lagunite.umd.cjs",
  "module": "./dist/lagunite.js",
  "style": "./dist/lagunite.css",
  "exports": {
    ".": {
      "import": "./dist/lagunite.js",
      "require": "./dist/lagunite.umd.cjs"
    },
    "./style.css": "./dist/lagunite.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "predev": "node scripts/generate-imports.js",
    "dev": "vite",
    "prebuild": "node scripts/generate-imports.js",
    "build:dev": "set NODE_ENV=development && vite build --mode development",
    "build": "npm run increment-build && vite build",
    "preview": "vite preview",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write \"src/**/*.{js,css,md} *.js\"",
    "docs": "npm run docs:generate && npm run docs:merge",
    "docs:generate": "node scripts/generate-css-docs.js",
    "docs:merge": "node scripts/merge-docs.js",
    "docs:watch": "nodemon --watch src/css --ext css --exec npm run docs:generate",
    "increment-build": "node scripts/increment-dev-compile-count.js"
  },
  "devDependencies": {
    "@toon-format/toon": "^1.3.0",
    "autoprefixer": "^10.4.19",
    "cssnano": "^7.0.1",
    "postcss": "^8.4.38",
    "postcss-import": "^16.1.0",
    "postcss-preset-env": "^9.5.14",
    "prettier": "^3.3.2",
    "stylelint": "^16.6.1",
    "stylelint-config-standard": "^36.0.0",
    "vite": "^5.2.13"
  },
  "author": "Ariel Diaz <ariel@laguna.com.ar>",
  "license": "MIT"
}